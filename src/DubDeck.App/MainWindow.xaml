<Window x:Class="DubDeck.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF" xmlns:local="clr-namespace:DubDeck.App"
 Background="#10141D" Foreground="#EBEFF7" FontFamily="Segoe UI" FontSize="13" Icon="Assets/DubDeck.ico" Title="DubDeck" Width="1280" Height="850" MinWidth="960" MinHeight="650" AllowDrop="True"
 DragOver="FilesDragOver" Drop="FilesDropped" PreviewKeyDown="WindowKeyDown" Closing="WindowClosing" Loaded="WindowLoaded" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <Style x:Key="OsdButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="4,0"/>
   <Setter Property="Background" Value="#253244"/><Setter Property="BorderBrush" Value="#35475D"/>
  </Style>
  <Style x:Key="IconToggle" TargetType="CheckBox">
   <Setter Property="Width" Value="32"/><Setter Property="Height" Value="26"/><Setter Property="Foreground" Value="#9FB1C9"/>
   <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
    <Border x:Name="ToggleShell" Background="#253245" BorderBrush="#36475C" BorderThickness="1" CornerRadius="6" Padding="3">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="ToggleShell" Property="Background" Value="#20463F"/><Setter TargetName="ToggleShell" Property="BorderBrush" Value="#6CE5C0"/><Setter Property="Foreground" Value="#8DEBCF"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ToggleShell" Property="Opacity" Value=".8"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ToggleShell" Property="BorderBrush" Value="#6CE5C0"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ToggleShell" Property="Opacity" Value=".4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SubtitleItem" TargetType="MenuItem">
   <Setter Property="Foreground" Value="#EBEFF7"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
   <Setter Property="Margin" Value="0,2"/><Setter Property="Padding" Value="12,9"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
    <Border x:Name="ItemShell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid x:Name="SelectionMark" Width="15" Height="15" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Hidden">
       <Ellipse Stroke="#6CE5C0" StrokeThickness="1.5"/><Ellipse Width="7" Height="7" Fill="#6CE5C0"/>
      </Grid>
      <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
     </Grid>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemShell" Property="Background" Value="#25364B"/><Setter TargetName="ItemShell" Property="BorderBrush" Value="#465A73"/></Trigger>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="SelectionMark" Property="Visibility" Value="Visible"/><Setter TargetName="ItemShell" Property="Background" Value="#204139"/><Setter TargetName="ItemShell" Property="BorderBrush" Value="#456D60"/></Trigger>
     <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsChecked" Value="True"/><Condition Property="IsHighlighted" Value="True"/></MultiTrigger.Conditions><Setter TargetName="ItemShell" Property="Background" Value="#285246"/><Setter TargetName="ItemShell" Property="BorderBrush" Value="#6CE5C0"/></MultiTrigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ItemShell" Property="Opacity" Value=".5"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SubtitleNote" TargetType="MenuItem">
   <Setter Property="Focusable" Value="False"/><Setter Property="IsEnabled" Value="False"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem"><ContentPresenter ContentSource="Header" Margin="12,9"/></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SubtitlesMenu" TargetType="ContextMenu">
   <Setter Property="MinWidth" Value="360"/><Setter Property="MaxWidth" Value="420"/><Setter Property="Foreground" Value="#EBEFF7"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="13"/>
   <Setter Property="HasDropShadow" Value="False"/><Setter Property="ItemContainerStyle" Value="{StaticResource SubtitleItem}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
    <Border Padding="8" CornerRadius="14" Background="#FA161E2B" BorderBrush="#43556E" BorderThickness="1" SnapsToDevicePixels="True">
     <StackPanel>
      <StackPanel Margin="12,9,12,13"><TextBlock Text="Subtitles" FontSize="17" FontWeight="SemiBold" Foreground="#EBEFF7"/><TextBlock Text="{TemplateBinding Tag}" FontSize="11" Foreground="#91A3BC" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" MaxWidth="360"/></StackPanel>
      <Border Background="#2D3C50" Height="1" Margin="4,0,4,7"/>
      <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/></ScrollViewer>
      <Border x:Name="SubtitleFooter" BorderBrush="#2D3C50" BorderThickness="0,1,0,0" Margin="4,10,4,0" Padding="0,10,0,2">
       <Button x:Name="OpenSubtitleFileButton" Content="Open subtitle file…" Click="OpenSubtitleFileClicked" Margin="0" Padding="12,9" HorizontalAlignment="Stretch" Background="#25364B" BorderBrush="#465A73" ToolTip="Choose a subtitle file on your computer" AutomationProperties.Name="Open subtitle file"/>
      </Border>
     </StackPanel>
    </Border>
    <ControlTemplate.Triggers><Trigger Property="DataContext" Value="{x:Null}"><Setter TargetName="SubtitleFooter" Property="Visibility" Value="Collapsed"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid x:Name="Root">
  <Grid.RowDefinitions><RowDefinition Height="66"/><RowDefinition Height="*" MinHeight="120"/><RowDefinition Height="82"/><RowDefinition Height="316"/><RowDefinition Height="30"/></Grid.RowDefinitions>
  <Border x:Name="Header" Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="#2A3343" BorderThickness="0,0,0,1" Padding="18,0">
   <DockPanel LastChildFill="False">
    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><Border Background="#6CE5C0" Width="5" Height="26" CornerRadius="2" Margin="0,0,10,0"/><TextBlock x:Name="BrandLabel" Text="DUBDECK" FontWeight="Bold" FontSize="18"/><TextBlock x:Name="ProjectLabel" Text="Untitled" Foreground="{StaticResource Muted}" Margin="20,0,8,0" MaxWidth="150" TextTrimming="CharacterEllipsis"/></StackPanel>
    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button local:AppIcons.Kind="file-plus" ToolTip="New project · Ctrl+N" AutomationProperties.Name="New project · Ctrl+N"  Click="NewClicked"/><Button local:AppIcons.Kind="folder-open" ToolTip="Open project · Ctrl+O" AutomationProperties.Name="Open project · Ctrl+O"  Click="OpenClicked"/><Button local:AppIcons.Kind="save" ToolTip="Save project · Ctrl+S" AutomationProperties.Name="Save project · Ctrl+S"  Click="SaveClicked"/><Button local:AppIcons.Kind="save-all" ToolTip="Save as · Ctrl+Shift+S" AutomationProperties.Name="Save as · Ctrl+Shift+S"  Click="SaveAsClicked"/><Button local:AppIcons.Kind="file-input" ToolTip="Import media · Ctrl+I" AutomationProperties.Name="Import media · Ctrl+I"  x:Name="ImportButton" Background="#6CE5C0" BorderBrush="#6CE5C0" Foreground="#10251E" FontWeight="SemiBold" Click="ImportClicked" Margin="14,0,0,0"/></StackPanel>
   </DockPanel>
  </Border>
  <Border x:Name="PreviewBorder" Grid.Row="1" Background="Black" Margin="18,14,18,0" CornerRadius="6" ClipToBounds="True">
   <Grid>
    
    <vlc:VideoView x:Name="VideoHost" Visibility="Visible" Background="Black">
     <Grid x:Name="VideoOverlay" TextElement.Foreground="#EBEFF7" TextElement.FontFamily="Segoe UI" Background="#01000000" MouseLeftButtonDown="PreviewClicked" MouseMove="OverlayMouseMove" PreviewKeyDown="WindowKeyDown">
<Border x:Name="BlankVideo" Background="Black"/>
<StackPanel x:Name="EmptyPreview" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="▷" FontSize="48" Foreground="#6CE5C0" HorizontalAlignment="Center" Margin="0,0,0,10"/><TextBlock x:Name="PreviewTitle" Text="Your timeline starts here" FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock x:Name="PreviewHint" Text="Import video or audio, or drop files into the window" Foreground="#98A6BC" Margin="0,10,0,0" HorizontalAlignment="Center"/></StackPanel>
      <Border x:Name="FullVideoControls" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" MaxWidth="1120" Margin="32,0,32,28" Padding="24,18" Background="#F2161E2B" BorderBrush="#344255" BorderThickness="1" CornerRadius="16">
       <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity=".3"/></Border.Effect>
       <StackPanel>
        <Grid Margin="0,0,0,14">
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <StackPanel VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock x:Name="FullBrandLabel" Text="DUBDECK" FontSize="10" Foreground="#8194B0"/><TextBlock x:Name="FullTitle" Text="Untitled" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/></StackPanel>
         <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button x:Name="FullPlay" Style="{StaticResource OsdButton}" Width="46" Height="46" Background="#6CE5C0" Foreground="#10251E" BorderBrush="#6CE5C0" local:AppIcons.Kind="play" Click="PlayClicked" ToolTip="Play / pause · Space" AutomationProperties.Name="Play or pause"/>
          <Button x:Name="FullStopButton" Style="{StaticResource OsdButton}" local:AppIcons.Kind="square" Click="StopClicked" ToolTip="Stop and return to start" AutomationProperties.Name="Stop"/>
          <TextBlock x:Name="FullTime" Text="00:00 / 00:00" FontFamily="Consolas" FontSize="12" Foreground="#C1CEE0" Margin="12,0,18,0"/>
         </StackPanel>
         <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="FullMute" Style="{StaticResource OsdButton}" Click="MasterMuteClicked" ToolTip="Mute master" AutomationProperties.Name="Mute master"/>
          <StackPanel VerticalAlignment="Center" Margin="4,0,0,0"><TextBlock Text="MASTER" FontSize="9" Foreground="#8194B0" Margin="3,0,0,0"/><Slider x:Name="FullVolume" Width="105" Value="100" ValueChanged="MasterVolumeChanged" ToolTip="Master volume" AutomationProperties.Name="Master volume"/></StackPanel>
          <TextBlock x:Name="FullMasterValue" Text="100%" FontSize="11" Width="37" Foreground="#C1CEE0" Margin="6,0,6,0"/>
          <Button x:Name="FullTrackButton" Style="{StaticResource OsdButton}" Content="Track controls" Width="Auto" Padding="12,6" Click="TrackControlsClicked" ToolTip="Track volume, mute, pause, Voice and auto duck" AutomationProperties.Name="Track controls"/>
          <Button x:Name="FullSubtitlesButton" Style="{StaticResource OsdButton}" local:AppIcons.Kind="captions" Click="SubtitlesClicked" ToolTip="Subtitles" AutomationProperties.Name="Subtitles"/>
          <Button Style="{StaticResource OsdButton}" local:AppIcons.Kind="minimize" Click="FullscreenClicked" ToolTip="Exit fullscreen · Esc" AutomationProperties.Name="Exit fullscreen"/>
         </StackPanel>
        </Grid>
        <Slider x:Name="FullSeekBar" Maximum="1" PreviewMouseLeftButtonDown="SeekStarted" PreviewMouseLeftButtonUp="SeekFinished" ValueChanged="SeekValueChanged" ToolTip="Seek" AutomationProperties.Name="Fullscreen seek" Margin="0,0,0,14"/>
        <TextBlock HorizontalAlignment="Right" Text="Space  Play / pause     ← / →  10s" FontSize="10" Foreground="#8194B0"/>
        <Popup x:Name="FullTrackPopup" Placement="Top" PlacementTarget="{Binding ElementName=FullVideoControls}" HorizontalOffset="24" VerticalOffset="-12" AllowsTransparency="True" StaysOpen="False" Opened="TrackPopupOpened" Closed="TrackPopupClosed">
         <Border Width="720" Padding="20" CornerRadius="14" Background="#FA161E2B" BorderBrush="#43556E" BorderThickness="1" Focusable="True" KeyboardNavigation.TabNavigation="Cycle" PreviewKeyDown="TrackPopupKeyDown" TextElement.Foreground="#EBEFF7" TextElement.FontFamily="Segoe UI">
          <StackPanel>
           <DockPanel Margin="4,0,4,14">
            <Button Content="×" FontSize="18" Width="30" Height="30" Padding="2" DockPanel.Dock="Right" HorizontalAlignment="Right" Click="CloseTrackControlsClicked" ToolTip="Close track controls · Esc" AutomationProperties.Name="Close track controls"/>
            <StackPanel><TextBlock Text="Track controls" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Levels, pause and voice triggering" FontSize="11" Foreground="#8194B0" Margin="0,4,0,0"/></StackPanel>
           </DockPanel>
           <ScrollViewer x:Name="FullTrackScroll" MaxHeight="340" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><WrapPanel x:Name="FullVideoMixer" HorizontalAlignment="Center"/></ScrollViewer>
           <Border BorderBrush="#2D3C50" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="6,14,6,0"><StackPanel x:Name="FullDuckControls" Orientation="Horizontal"/></Border>
          </StackPanel>
         </Border>
        </Popup>
       </StackPanel>
      </Border>
      <Border x:Name="FullEmptyControls" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" MaxWidth="1120" Margin="32,0,32,28" Padding="24,18" Background="#F2161E2B" BorderBrush="#344255" BorderThickness="1" CornerRadius="16">
       <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity=".3"/></Border.Effect>
       <StackPanel>
        <Grid Margin="0,0,0,14">
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <StackPanel VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock x:Name="EmptyBrandLabel" Text="DUBDECK" FontSize="10" Foreground="#8194B0"/><TextBlock x:Name="EmptyTitle" Text="Untitled" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/></StackPanel>
         <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button x:Name="EmptyPlay" Style="{StaticResource OsdButton}" Width="46" Height="46" Background="#6CE5C0" Foreground="#10251E" BorderBrush="#6CE5C0" local:AppIcons.Kind="play" Click="PlayClicked" ToolTip="Play / pause · Space" AutomationProperties.Name="Play or pause"/>
          <Button x:Name="EmptyStopButton" Style="{StaticResource OsdButton}" local:AppIcons.Kind="square" Click="StopClicked" ToolTip="Stop and return to start" AutomationProperties.Name="Stop"/>
          <TextBlock x:Name="EmptyTime" Text="00:00 / 00:00" FontFamily="Consolas" FontSize="12" Foreground="#C1CEE0" Margin="12,0,18,0"/>
         </StackPanel>
         <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="EmptyMute" Style="{StaticResource OsdButton}" Click="MasterMuteClicked" ToolTip="Mute master" AutomationProperties.Name="Mute master"/>
          <StackPanel VerticalAlignment="Center" Margin="4,0,0,0"><TextBlock Text="MASTER" FontSize="9" Foreground="#8194B0" Margin="3,0,0,0"/><Slider x:Name="EmptyVolume" Width="105" Value="100" ValueChanged="MasterVolumeChanged" ToolTip="Master volume" AutomationProperties.Name="Master volume"/></StackPanel>
          <TextBlock x:Name="EmptyMasterValue" Text="100%" FontSize="11" Width="37" Foreground="#C1CEE0" Margin="6,0,6,0"/>
          <Button x:Name="EmptyTrackButton" Style="{StaticResource OsdButton}" Content="Track controls" Width="Auto" Padding="12,6" Click="TrackControlsClicked" ToolTip="Track volume, mute, pause, Voice and auto duck" AutomationProperties.Name="Track controls"/>
          <Button x:Name="EmptySubtitlesButton" Style="{StaticResource OsdButton}" local:AppIcons.Kind="captions" Click="SubtitlesClicked" ToolTip="Subtitles" AutomationProperties.Name="Subtitles"/>
          <Button Style="{StaticResource OsdButton}" local:AppIcons.Kind="minimize" Click="FullscreenClicked" ToolTip="Exit fullscreen · Esc" AutomationProperties.Name="Exit fullscreen"/>
         </StackPanel>
        </Grid>
        <Slider x:Name="EmptySeekBar" Maximum="1" PreviewMouseLeftButtonDown="SeekStarted" PreviewMouseLeftButtonUp="SeekFinished" ValueChanged="SeekValueChanged" ToolTip="Seek" AutomationProperties.Name="Fullscreen seek" Margin="0,0,0,14"/>
        <TextBlock HorizontalAlignment="Right" Text="Space  Play / pause     ← / →  10s" FontSize="10" Foreground="#8194B0"/>
        <Popup x:Name="EmptyTrackPopup" Placement="Top" PlacementTarget="{Binding ElementName=FullEmptyControls}" HorizontalOffset="24" VerticalOffset="-12" AllowsTransparency="True" StaysOpen="False" Opened="TrackPopupOpened" Closed="TrackPopupClosed">
         <Border Width="720" Padding="20" CornerRadius="14" Background="#FA161E2B" BorderBrush="#43556E" BorderThickness="1" Focusable="True" KeyboardNavigation.TabNavigation="Cycle" PreviewKeyDown="TrackPopupKeyDown" TextElement.Foreground="#EBEFF7" TextElement.FontFamily="Segoe UI">
          <StackPanel>
           <DockPanel Margin="4,0,4,14">
            <Button Content="×" FontSize="18" Width="30" Height="30" Padding="2" DockPanel.Dock="Right" HorizontalAlignment="Right" Click="CloseTrackControlsClicked" ToolTip="Close track controls · Esc" AutomationProperties.Name="Close track controls"/>
            <StackPanel><TextBlock Text="Track controls" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Levels, pause and voice triggering" FontSize="11" Foreground="#8194B0" Margin="0,4,0,0"/></StackPanel>
           </DockPanel>
           <ScrollViewer x:Name="EmptyTrackScroll" MaxHeight="340" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><WrapPanel x:Name="FullEmptyMixer" HorizontalAlignment="Center"/></ScrollViewer>
           <Border BorderBrush="#2D3C50" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="6,14,6,0"><StackPanel x:Name="EmptyDuckControls" Orientation="Horizontal"/></Border>
          </StackPanel>
         </Border>
        </Popup>
       </StackPanel>
      </Border>
      <Grid x:Name="ImportOverlay" Visibility="Collapsed" Panel.ZIndex="100" Background="#F010141D" Cursor="Wait" AutomationProperties.Name="Import in progress">
       <Viewbox HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10" Stretch="Uniform" StretchDirection="DownOnly"><Border Width="480" Padding="16" Background="#202938" BorderBrush="#6CE5C0" BorderThickness="1" CornerRadius="10">
        <StackPanel>
         <TextBlock x:Name="ImportHeading" Text="Loading files…" Foreground="#EBEFF7" FontSize="20" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/>
         <TextBlock x:Name="ImportDetail" Text="Preparing import…" Foreground="#C6D2E5" FontSize="13" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"/>
         <ProgressBar Height="6" IsIndeterminate="True" Foreground="#6CE5C0" Background="#354158" BorderThickness="0" Margin="0,12,0,12" AutomationProperties.Name="Loading media"/>
         <TextBlock Text="Please wait. You can import more files when this finishes." FontSize="12" Foreground="#98A6BC"/>
        </StackPanel>
       </Border></Viewbox>
      </Grid>
     </Grid>
    </vlc:VideoView>
    
   </Grid>
  </Border>
  <Grid x:Name="Transport" Grid.Row="2" Margin="18,8,18,6"><Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="26"/></Grid.RowDefinitions>
   <DockPanel LastChildFill="False"><StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><Button local:AppIcons.Kind="play" ToolTip="Play / pause · Space" AutomationProperties.Name="Play / pause · Space"  x:Name="PlayButton" Click="PlayClicked" Background="#6CE5C0" Foreground="#10251E" BorderBrush="#6CE5C0" FontWeight="SemiBold"/><Button x:Name="StopButton" local:AppIcons.Kind="square" ToolTip="Stop and return to start" AutomationProperties.Name="Stop and return to start"  Click="StopClicked"/><TextBlock x:Name="TimeLabel" Text="00:00.000 / 00:00.000" FontFamily="Consolas" FontSize="14" Margin="18,0"/></StackPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button x:Name="MasterMute" Content="Master" Click="MasterMuteClicked" ToolTip="Mute master output"/><Slider x:Name="MasterVolume" Width="130" Value="100" Margin="6,0" ValueChanged="MasterVolumeChanged" ToolTip="Master volume"/><TextBlock x:Name="MasterValue" Text="100%" Width="38"/><Button local:AppIcons.Kind="captions" ToolTip="Subtitles" AutomationProperties.Name="Subtitles"  x:Name="SubtitlesButton" Click="SubtitlesClicked" Padding="10,7"/><Button local:AppIcons.Kind="maximize" ToolTip="Toggle fullscreen · F11 / Escape" AutomationProperties.Name="Toggle fullscreen · F11 / Escape"  Click="FullscreenClicked" Margin="12,0,0,0"/></StackPanel></DockPanel>
   <Slider x:Name="SeekBar" Grid.Row="1" Maximum="1" Margin="2,0" PreviewMouseLeftButtonDown="SeekStarted" PreviewMouseLeftButtonUp="SeekFinished" ValueChanged="SeekValueChanged" ToolTip="Seek"/>
  </Grid>
  <Border x:Name="TimelinePanel" Grid.Row="3" Background="{StaticResource Panel}" BorderBrush="#2A3343" BorderThickness="0,1,0,1"><Grid><Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <DockPanel Margin="18,0" LastChildFill="False"><StackPanel x:Name="DuckControls" Orientation="Horizontal" DockPanel.Dock="Left"/><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button local:AppIcons.Kind="zoom-out" ToolTip="Zoom out" AutomationProperties.Name="Zoom out"  Click="ZoomOutClicked" Padding="10,2"/><TextBlock x:Name="ZoomLabel" Text="100%" Width="48" TextAlignment="Center"/><Button local:AppIcons.Kind="zoom-in" ToolTip="Zoom in" AutomationProperties.Name="Zoom in"  Click="ZoomInClicked" Padding="10,2"/><Button Content="Fit timeline" ToolTip="Fit timeline" AutomationProperties.Name="Fit timeline"  Click="FitClicked" Padding="12,2"/></StackPanel></DockPanel>

   <Grid Grid.Row="1">
    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <ScrollViewer x:Name="TrackScroll" Height="{Binding ViewportHeight, ElementName=TimelineScroll}" VerticalAlignment="Top" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" Padding="0" PreviewMouseWheel="TrackHeadersWheel">
     <StackPanel>
      <Border Height="{x:Static local:TimelineSurface.RulerHeight}" Background="#141A25" BorderBrush="#293344" BorderThickness="0,0,0,1"><TextBlock Text="TRACK / LEVEL" FontSize="10" Foreground="#79879C" Margin="18,0"/></Border>
      <StackPanel x:Name="TrackHeaders"/>
     </StackPanel>
    </ScrollViewer>
    <ScrollViewer x:Name="TimelineScroll" Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanContentScroll="False" Padding="0" ScrollChanged="TimelineScrolled" PreviewMouseWheel="TimelineWheel">
     <local:TimelineSurface x:Name="Timeline" HorizontalAlignment="Left" VerticalAlignment="Top"/>
    </ScrollViewer>
    <Border x:Name="EmptyTimelineOverlay" Grid.Column="1" Margin="0,30,0,0" Panel.ZIndex="10" Background="#EC141A25" Visibility="Collapsed" AutomationProperties.Name="Empty timeline">
     <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16">
      <TextBlock Text="Drag and drop video or audio here" FontSize="15" FontWeight="SemiBold" Foreground="#E0E9F6" TextAlignment="Center"/>
      <TextBlock Text="or import media to start your timeline" FontSize="12" Foreground="#91A3BC" Margin="0,6,0,12" TextAlignment="Center"/>
      <Button Content="Import media" Click="ImportClicked" HorizontalAlignment="Center" Padding="16,7" Background="#254D42" BorderBrush="#6CE5C0" ToolTip="Import video or audio · Ctrl+I" AutomationProperties.Name="Import media into the empty timeline"/>
     </StackPanel>
    </Border>
   </Grid>
  </Grid></Border>
  <Popup x:Name="StopConfirmationPopup" Placement="Top" VerticalOffset="-10" AllowsTransparency="True" StaysOpen="False" Opened="StopConfirmationOpened" Closed="StopConfirmationClosed">
   <Border Width="360" Padding="20" CornerRadius="14" Background="#FA161E2B" BorderBrush="#43556E" BorderThickness="1" TextElement.Foreground="#EBEFF7" TextElement.FontFamily="Segoe UI" KeyboardNavigation.TabNavigation="Cycle" PreviewKeyDown="StopConfirmationKeyDown">
    <StackPanel>
     <TextBlock Text="Stop and return to start?" FontSize="17" FontWeight="SemiBold"/>
     <TextBlock Text="Playback will stop and the playhead will move to 00:00." FontSize="12" Foreground="#A3B3C9" TextWrapping="Wrap" Margin="0,9,0,18"/>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="CancelStopButton" Content="Cancel" Click="CancelStopClicked" MinWidth="84" Padding="14,7" ToolTip="Keep the current playback position"/>
      <Button x:Name="ConfirmStopButton" Content="Stop" Click="ConfirmStopClicked" MinWidth="84" Padding="14,7" Margin="10,0,0,0" Background="#F4C67F" BorderBrush="#F4C67F" Foreground="#291F0D" FontWeight="SemiBold"/>
     </StackPanel>
    </StackPanel>
