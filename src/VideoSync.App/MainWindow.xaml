<Window x:Class="VideoSync.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF" xmlns:local="clr-namespace:VideoSync.App"
 Background="#10141D" Foreground="#EBEFF7" FontFamily="Segoe UI" FontSize="13" Title="Video Sync" Width="1280" Height="850" MinWidth="960" MinHeight="650" AllowDrop="True"
 DragOver="FilesDragOver" Drop="FilesDropped" PreviewKeyDown="WindowKeyDown" Closing="WindowClosing" Loaded="WindowLoaded" WindowStartupLocation="CenterScreen">
 <Grid x:Name="Root">
  <Grid.RowDefinitions><RowDefinition Height="66"/><RowDefinition Height="*" MinHeight="120"/><RowDefinition Height="82"/><RowDefinition Height="284"/><RowDefinition Height="30"/></Grid.RowDefinitions>
  <Border x:Name="Header" Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="#2A3343" BorderThickness="0,0,0,1" Padding="18,0">
   <DockPanel LastChildFill="False">
    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><Border Background="#6CE5C0" Width="5" Height="26" CornerRadius="2" Margin="0,0,10,0"/><TextBlock Text="VIDEO SYNC" FontWeight="Bold" FontSize="18"/><TextBlock x:Name="ProjectLabel" Text="Untitled" Foreground="{StaticResource Muted}" Margin="20,0,8,0" MaxWidth="150" TextTrimming="CharacterEllipsis"/></StackPanel>
    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="New" Click="NewClicked" ToolTip="New project · Ctrl+N"/><Button Content="Open" Click="OpenClicked" ToolTip="Open project · Ctrl+O"/><Button Content="Save" Click="SaveClicked" ToolTip="Save project · Ctrl+S"/><Button Content="Save as" Click="SaveAsClicked"/><Button x:Name="ImportButton" Content="＋  Import media" Background="#6CE5C0" BorderBrush="#6CE5C0" Foreground="#10251E" FontWeight="SemiBold" Click="ImportClicked" Margin="14,0,0,0"/></StackPanel>
   </DockPanel>
  </Border>
  <Border x:Name="PreviewBorder" Grid.Row="1" Background="Black" Margin="18,14,18,0" CornerRadius="6" ClipToBounds="True">
   <Grid>
    
    <vlc:VideoView x:Name="VideoHost" Visibility="Visible" Background="Black">
     <Grid x:Name="VideoOverlay" TextElement.Foreground="#EBEFF7" TextElement.FontFamily="Segoe UI" Background="#01000000" MouseLeftButtonDown="PreviewClicked" PreviewKeyDown="WindowKeyDown">
<Border x:Name="BlankVideo" Background="Black"/>
<StackPanel x:Name="EmptyPreview" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="▷" FontSize="48" Foreground="#6CE5C0" HorizontalAlignment="Center" Margin="0,0,0,10"/><TextBlock x:Name="PreviewTitle" Text="Your timeline starts here" FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock x:Name="PreviewHint" Text="Import video or audio, or drop files into the window" Foreground="#98A6BC" Margin="0,10,0,0" HorizontalAlignment="Center"/></StackPanel>
      <Border x:Name="FullVideoControls" Visibility="Collapsed" VerticalAlignment="Bottom" Background="#E6191F2B" Padding="22,15" Margin="20">
       <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button x:Name="FullPlay" Content="▶  Play" Click="PlayClicked" MinWidth="100"/><Button Content="■  Stop" Click="StopClicked"/><TextBlock x:Name="FullTime" Text="00:00 / 00:00" FontFamily="Consolas" Margin="18,0"/><Button x:Name="FullMute" Content="Master" Click="MasterMuteClicked"/><Slider x:Name="FullVolume" Width="140" Value="100" ValueChanged="MasterVolumeChanged" ToolTip="Master volume"/><Button Content="Exit fullscreen  Esc" Click="FullscreenClicked" Margin="18,0,0,0"/></StackPanel>
      </Border>
<Border x:Name="FullEmptyControls" Visibility="Collapsed" VerticalAlignment="Bottom" Background="#E6191F2B" Padding="20" Margin="20">
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button Content="Play / pause" Click="PlayClicked"/><Button Content="Stop" Click="StopClicked"/><Button x:Name="EmptyMute" Content="Master" Click="MasterMuteClicked"/><Slider x:Name="EmptyVolume" Width="140" Value="100" ValueChanged="MasterVolumeChanged" ToolTip="Master volume"/><Button Content="Exit fullscreen  Esc" Click="FullscreenClicked"/></StackPanel>
    </Border>
     </Grid>
    </vlc:VideoView>
    
   </Grid>
  </Border>
  <Grid x:Name="Transport" Grid.Row="2" Margin="18,8,18,6"><Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="26"/></Grid.RowDefinitions>
   <DockPanel LastChildFill="False"><StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><Button x:Name="PlayButton" Content="▶  Play" Click="PlayClicked" Background="#6CE5C0" Foreground="#10251E" BorderBrush="#6CE5C0" MinWidth="105" FontWeight="SemiBold"/><Button Content="■  Stop" Click="StopClicked"/><TextBlock x:Name="TimeLabel" Text="00:00.000 / 00:00.000" FontFamily="Consolas" FontSize="14" Margin="18,0"/></StackPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button x:Name="MasterMute" Content="Master" Click="MasterMuteClicked" ToolTip="Mute master output"/><Slider x:Name="MasterVolume" Width="130" Value="100" Margin="6,0" ValueChanged="MasterVolumeChanged" ToolTip="Master volume"/><TextBlock x:Name="MasterValue" Text="100%" Width="38"/><Button Content="⛶  Fullscreen" Click="FullscreenClicked" Margin="12,0,0,0" ToolTip="Fullscreen preview · F11"/></StackPanel></DockPanel>
   <Slider x:Name="SeekBar" Grid.Row="1" Maximum="1" Margin="2,0" PreviewMouseLeftButtonDown="SeekStarted" PreviewMouseLeftButtonUp="SeekFinished" ValueChanged="SeekValueChanged" ToolTip="Seek"/>
  </Grid>
  <Border x:Name="TimelinePanel" Grid.Row="3" Background="{StaticResource Panel}" BorderBrush="#2A3343" BorderThickness="0,1,0,1"><Grid><Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <DockPanel Margin="18,0" LastChildFill="False"><StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><TextBlock Text="TIMELINE" FontWeight="SemiBold" Foreground="#98A6BC" FontSize="11"/><TextBlock Text="Whole files · drag to position" Foreground="#79879C" Margin="18,0,0,0"/><Button Content="Add audio track" Click="AddTrackClicked" Padding="10,3" Margin="18,0,0,0"/></StackPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="−" Click="ZoomOutClicked" Padding="10,2"/><TextBlock x:Name="ZoomLabel" Text="100%" Width="48" TextAlignment="Center"/><Button Content="＋" Click="ZoomInClicked" Padding="10,2"/><Button Content="Fit" Click="FitClicked" Padding="12,2"/></StackPanel></DockPanel>
   <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid Grid.Column="0"><Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="TRACK / LEVEL" FontSize="10" Foreground="#79879C" Margin="18,0"/><ScrollViewer x:Name="TrackScroll" Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False"><StackPanel x:Name="TrackHeaders"/></ScrollViewer></Grid><ScrollViewer x:Name="TimelineScroll" Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanContentScroll="False" ScrollChanged="TimelineScrolled" PreviewMouseWheel="TimelineWheel"><local:TimelineSurface x:Name="Timeline"/></ScrollViewer></Grid>
  </Grid></Border>
  <DockPanel x:Name="Footer" Grid.Row="4" Margin="18,0" LastChildFill="True"><TextBlock Text="Space  Play/pause     Home  Start     F11  Fullscreen" Foreground="#79879C" FontSize="11" DockPanel.Dock="Right"/><TextBlock x:Name="StatusText" Text="Ready · Import files to get started" Foreground="#98A6BC" FontSize="11" TextTrimming="CharacterEllipsis"/></DockPanel>
 </Grid>
</Window>